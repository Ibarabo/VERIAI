# =====================================================================
# VeriAI Africa - Production Environment Variables Template
# =====================================================================

# 1. Neon Cloud PostgreSQL Database (AWS London eu-west-2)
# Use the pooled connection string with sslmode=require for optimal serverless scaling
DATABASE_URL=postgresql://neondb_owner:<NEON_PASSWORD>@ep-round-bar-zap99bjr-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require

# 2. FastAPI Backend Service Configuration
APP_ENV=production
DEBUG=false
SECRET_KEY=<GENERATE_SECURE_64_CHAR_HEX_SECRET>
PORT=8000
CORS_ORIGINS=["https://veriai-africa.vercel.app","https://veriafrica.com","http://localhost:3000"]

# 3. Next.js Public Client Configuration
NEXT_PUBLIC_APP_NAME="VeriAI Africa"
NEXT_PUBLIC_BACKEND_URL=https://veriai-africa-backend.fly.dev
NEXT_PUBLIC_SITE_URL=https://veriai-africa.vercel.app

# 4. Optional AI LLM Integration
GEMINI_API_KEY=<OPTIONAL_GOOGLE_GEMINI_API_KEY>

# 5. Production Deployment Quick Commands:
# Fly.io Backend Deployment:
#   fly auth login
#   fly apps create veriai-africa-backend
#   fly secrets set DATABASE_URL="postgresql://neondb_owner:..." SECRET_KEY="..."
#   fly deploy
#
# Vercel Frontend Deployment:
#   vercel --prod
